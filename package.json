{
  "name": "kirim",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/init-env.mjs && node --env-file-if-exists=.env scripts/setup-wallets.mjs",
    "escrow:smoke": "node --env-file-if-exists=.env scripts/escrow-smoke.mjs",
    "ledger": "node --env-file-if-exists=.env services/ledger/src/index.mjs",
    "market": "node --env-file-if-exists=.env services/market/src/index.mjs",
    "orchestrator": "node --env-file-if-exists=.env services/orchestrator/src/index.mjs",
    "trade": "node --env-file-if-exists=.env services/orchestrator/src/cli.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "milestone": "node --env-file-if-exists=.env services/orchestrator/src/cli-works.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "credential:smoke": "node --env-file-if-exists=.env scripts/credential-smoke.mjs",
    "topup": "node --env-file-if-exists=.env scripts/topup.mjs",
    "authorise": "node --env-file-if-exists=.env scripts/authorise.mjs",
    "credit:status": "node --env-file-if-exists=.env -e \"import(process.cwd()+\"/packages/mpp/src/credit.mjs\").then(m=>console.log(JSON.stringify(m.status(),null,2)))\"",
    "init": "node scripts/init-env.mjs"
  },
  "dependencies": {
    "mppx": "^0.8.19",
    "xrpl": "^4.1.0",
    "xrpl-mpp-sdk": "^0.1.0-beta.2"
  },
  "optionalDependencies": {
    "@t54-labs/clawcredit-sdk": "^0.4.4"
  }
}
