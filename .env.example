# --- XRPL ---
XRPL_ENDPOINT=wss://s.altnet.rippletest.net:51233
XRPL_EXPLORER=https://testnet.xrpl.org

# --- Settlement currency ---
# RLUSD testnet issuer address. Get RLUSD + the issuer from https://tryrlusd.com
# Leave SETTLEMENT=XRP to run the whole flow in XRP drops if RLUSD/TokenEscrow is unavailable.
SETTLEMENT=RLUSD
RLUSD_CURRENCY=524C555344000000000000000000000000000000
# issuer below is RLUSD_XRPL_ISSUER_TESTNET from t54-labs/rlusd-cli
RLUSD_ISSUER=rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV

# Testnet faucets cannot fund a real trade principal (10 RLUSD/24h, or 100 XRP).
# The principal is divided by this before it touches the ledger; responses say so.
SETTLEMENT_DIVISOR=5000

# Kirim charges 0.8% of each released milestone, at the moment of release.
PLATFORM_FEE_BPS=80

# --- Service authentication ---
# The ledger service holds every seed. Routes that move money require this.
LEDGER_TOKEN=<generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
# Binds MPP challenges to their contents so the market can verify what it issued.
MPP_SECRET_KEY=<generate one the same way>

# --- Spend controls (enforced server-side in the ledger service) ---
MAX_PER_CALL_USD=1.00
MAX_PER_TRADE_USD=5.00
MAX_PER_RUN_USD=500.00
HUMAN_APPROVAL_ABOVE_USD=12000.00

# --- Ports ---
MARKET_PORT=4020
LEDGER_PORT=4010
ORCHESTRATOR_PORT=4000

# --- Agent attribution ---
# Leave unset to use the XRPL AI Starter Kit default (20260530).
# AGENT_SOURCE_TAG=

# --- Milestone review notes (optional) ---
# The rules decide whether money moves; the model only writes the advice.
# Without a key the product still runs end to end on composed text.
#
# Any ONE of these:
#   ANTHROPIC_API_KEY=sk-ant-...
#   OPENAI_API_KEY=sk-...                       # OpenAI
#   OPENAI_API_KEY=gsk_...  OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_API_KEY=...      OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_API_KEY=ollama   OPENAI_BASE_URL=http://localhost:11434/v1   # local, no key needed
#
# KIRIM_MODEL overrides the default for whichever provider is in use.
# KIRIM_MODEL=
