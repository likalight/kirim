# --- XRPL ---
XRPL_ENDPOINT=wss://s.altnet.rippletest.net:51233
XRPL_EXPLORER=https://testnet.xrpl.org

# --- Settlement currency ---
# RLUSD testnet issuer address. Get RLUSD + the issuer from https://tryrlusd.com
# Leave SETTLEMENT=XRP to run the whole flow in XRP drops if RLUSD/TokenEscrow is unavailable.
SETTLEMENT=RLUSD
RLUSD_CURRENCY=524C555344000000000000000000000000000000
RLUSD_ISSUER=

# --- Spend controls (enforced server-side in the ledger service) ---
MAX_PER_CALL_USD=1.00
MAX_PER_TRADE_USD=250.00
MAX_PER_RUN_USD=500.00
HUMAN_APPROVAL_ABOVE_USD=5000.00

# --- Ports ---
MARKET_PORT=4020
LEDGER_PORT=4010
ORCHESTRATOR_PORT=4000

# --- Agent attribution ---
AGENT_SOURCE_TAG=880402
